<style>
:root{--violet:#a855f7;--neon:#d946ef;--bg:#0a0a14}
*{margin:0;padding:0;box-sizing:border-box}
body{background:var(--bg);color:white;font-family:Inter,sans-serif;overflow-x:hidden}
.bg-glow{position:fixed;top:0;left:0;width:100%;height:100%;background:radial-gradient(circle at 50% 0%, #4c1d95 0%, transparent 60%);pointer-events:none;z-index:-1}
nav{display:flex;justify-content:space-between;align-items:center;padding:20px 5%;border-bottom:1px solid #ffffff15}
.logo{font-family:Orbitron;font-weight:900;color:var(--violet);font-size:28px;letter-spacing:2px}
.btn-neon{border:1px solid var(--violet);background:#a855f722;padding:12px 24px;border-radius:10px;color:white;text-decoration:none;font-weight:700;box-shadow:0 0 20px #a855f7;transition:0.3s}
.btn-neon:hover{transform:scale(1.05);box-shadow:0 0 30px var(--neon)}
.hero{display:grid;grid-template-columns:1.2fr 0.8fr;padding:80px 5%;align-items:center}
.hero h1{font-family:Orbitron;font-size: clamp(40px,6vw,90px);background:linear-gradient(90deg,#ff8aff,#a855f7);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:0.9}
.hero p{opacity:0.7;margin:20px 0 30px;font-size:18px}
.links{display:flex;gap:15px;flex-wrap:wrap}
.card{border:1px solid #a855f740;background:#111122;border-radius:16px;padding:20px;box-shadow:0 0 20px #000}
.team{padding:40px 5%;display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px}
.team h3{color:var(--neon);font-family:Orbitron;text-align:center;margin-bottom:20px;grid-column:1/-1;letter-spacing:3px}
.member{text-align:center}
.member img{width:90px;height:90px;border-radius:50%;border:2px solid var(--violet);box-shadow:0 0 20px var(--violet)}
.games{padding:20px 5% 80px;display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}
.tag{background:var(--violet);padding:4px 10px;border-radius:20px;font-size:12px}
footer{text-align:center;padding:30px;opacity:0.5;border-top:1px solid #ffffff10;font-size:13px}
</style>
</head>
